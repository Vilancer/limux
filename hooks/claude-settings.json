{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_CLAUDE_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks claude notification || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Claude session restore",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
