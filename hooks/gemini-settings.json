{
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks gemini stop || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Gemini session restore",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks gemini post-tool-use || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Gemini activity",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks gemini prompt-submit || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Gemini session restore",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks gemini notification || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Gemini session restore",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks gemini session-end || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Gemini session restore",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks gemini session-start || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Gemini session restore",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ]
  }
}