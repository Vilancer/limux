{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_CODEX_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks codex interrupt || echo '{}'",
            "statusMessage": "Limux Codex activity",
            "timeout": 3,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_CODEX_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks codex permission-request || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Codex activity",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_CODEX_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks codex post-tool-use || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "Limux Codex activity",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_CODEX_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks codex session-end || echo '{}'",
            "statusMessage": "Limux Codex session restore",
