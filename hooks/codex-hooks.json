            "statusMessage": "Limux Codex session restore",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "[ \"${LIMUX_CODEX_HOOKS_DISABLED:-}\" != \"1\" ] && limux --json hooks codex prompt-submit || echo '{\"continue\":true,\"suppressOutput\":false}'",
